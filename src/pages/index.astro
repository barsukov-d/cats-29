---
import { cats } from '../data/cats.js';
import CatCard from '../components/CatCard.astro';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Магазин супер котов — карточки товаров с суперспособностями, светлая и тёмная тема."
    />
    <title>Супер Коты — магазин котов с суперсилой</title>
    <!-- Устанавливаем тему до отрисовки, чтобы не было мигания -->
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem('theme');
          const prefersDark = window.matchMedia(
            '(prefers-color-scheme: dark)'
          ).matches;
          const theme = saved || (prefersDark ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#top">
          <span class="brand__logo" aria-hidden="true">🐾</span>
          <span class="brand__name">Супер Коты</span>
        </a>
        <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-label="Переключить тему"
        >
          <span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true">☀️</span>
          <span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true">🌙</span>
          <span class="theme-toggle__label">Тема</span>
        </button>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="container">
          <p class="hero__eyebrow">Только настоящие супергерои</p>
          <h1 class="hero__title">Супер коты с настоящими суперсилами</h1>
          <p class="hero__subtitle">
            Выбирайте котов с уникальными способностями. Наведите курсор на
            карточку — и почувствуйте объём.
          </p>
          <a class="hero__cta" href="#catalog">Смотреть каталог</a>
        </div>
      </section>

      <section id="catalog" class="catalog">
        <div class="container">
          <h2 class="section-title">Каталог супер котов</h2>
          <div class="grid">
            {cats.map((cat) => <CatCard cat={cat} />)}
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© 2026 Супер Коты. Все супергерои вымышлены, но обаятельны.</p>
      </div>
    </footer>

    <script>
      // Переключатель светлой/тёмной темы с сохранением в localStorage.
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {
          /* localStorage может быть недоступен */
        }
      });

      // 3D-эффект наклона карточек при движении курсора.
      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      if (!reduceMotion) {
        const MAX_TILT = 10; // градусов
        document.querySelectorAll('[data-tilt]').forEach((card) => {
          const inner = card.querySelector('.card__inner');
          if (!inner) return;

          card.addEventListener('mousemove', (event) => {
            const rect = card.getBoundingClientRect();
            const px = (event.clientX - rect.left) / rect.width;
            const py = (event.clientY - rect.top) / rect.height;
            const rotateY = (px - 0.5) * 2 * MAX_TILT;
            const rotateX = (0.5 - py) * 2 * MAX_TILT;
            inner.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-6px)`;
          });

          card.addEventListener('mouseleave', () => {
            inner.style.transform = '';
          });
        });
      }
    </script>

    <style is:global>
      :root {
        --accent: #6a5cff;
        --accent-strong: #5346e0;
      }

      html[data-theme='light'] {
        --bg: #f5f6fb;
        --bg-accent: #eceeff;
        --text-strong: #1a1c2b;
        --text-muted: #5a5f73;
        --card-bg: #ffffff;
        --card-border: rgba(20, 20, 40, 0.08);
        --card-shadow: 0 8px 24px rgba(30, 30, 60, 0.08);
        --card-shadow-hover: 0 20px 45px rgba(60, 60, 120, 0.22);
        --header-bg: rgba(255, 255, 255, 0.75);
        --hero-glow: radial-gradient(
          circle at 30% 20%,
          rgba(106, 92, 255, 0.18),
          transparent 60%
        );
      }

      html[data-theme='dark'] {
        --bg: #0e0f1a;
        --bg-accent: #14162a;
        --text-strong: #f4f5ff;
        --text-muted: #a7abc4;
        --card-bg: #1a1c2e;
        --card-border: rgba(255, 255, 255, 0.08);
        --card-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
        --card-shadow-hover: 0 24px 55px rgba(106, 92, 255, 0.35);
        --header-bg: rgba(14, 15, 26, 0.7);
        --hero-glow: radial-gradient(
          circle at 30% 20%,
          rgba(106, 92, 255, 0.28),
          transparent 60%
        );
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family:
          'Segoe UI', system-ui, -apple-system, Roboto, Helvetica, Arial,
          sans-serif;
        background: var(--bg);
        color: var(--text-strong);
        transition:
          background 0.3s ease,
          color 0.3s ease;
      }

      .container {
        width: min(1120px, 100% - 2.4rem);
        margin-inline: auto;
      }

      /* Шапка */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        backdrop-filter: blur(10px);
        background: var(--header-bg);
        border-bottom: 1px solid var(--card-border);
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.85rem 0;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 700;
        font-size: 1.15rem;
        color: var(--text-strong);
        text-decoration: none;
      }

      .brand__logo {
        font-size: 1.4rem;
      }

      .theme-toggle {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 0.85rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text-strong);
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 999px;
        cursor: pointer;
        transition:
          background 0.2s ease,
          transform 0.1s ease;
      }

      .theme-toggle:active {
        transform: scale(0.96);
      }

      .theme-toggle__icon {
        font-size: 1rem;
        line-height: 1;
      }

      /* В светлой теме показываем луну (предложение переключиться), в тёмной — солнце */
      html[data-theme='light'] .theme-toggle__icon--sun {
        display: none;
      }
      html[data-theme='dark'] .theme-toggle__icon--moon {
        display: none;
      }

      /* Герой */
      .hero {
        position: relative;
        padding: clamp(3rem, 8vw, 6rem) 0 clamp(2.5rem, 6vw, 4rem);
        background: var(--hero-glow);
      }

      .hero__eyebrow {
        margin: 0 0 0.6rem;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--accent);
      }

      .hero__title {
        margin: 0 0 1rem;
        font-size: clamp(2rem, 6vw, 3.4rem);
        line-height: 1.1;
        color: var(--text-strong);
      }

      .hero__subtitle {
        max-width: 34rem;
        margin: 0 0 1.8rem;
        font-size: clamp(1rem, 2.5vw, 1.15rem);
        line-height: 1.55;
        color: var(--text-muted);
      }

      .hero__cta {
        display: inline-block;
        padding: 0.8rem 1.6rem;
        font-weight: 600;
        color: #fff;
        background: var(--accent);
        border-radius: 12px;
        text-decoration: none;
        box-shadow: 0 10px 24px rgba(106, 92, 255, 0.35);
        transition:
          background 0.2s ease,
          transform 0.15s ease;
      }

      .hero__cta:hover {
        background: var(--accent-strong);
        transform: translateY(-2px);
      }

      /* Каталог */
      .catalog {
        padding: clamp(2rem, 6vw, 4rem) 0 clamp(3rem, 8vw, 5rem);
      }

      .section-title {
        margin: 0 0 1.8rem;
        font-size: clamp(1.5rem, 4vw, 2.1rem);
        color: var(--text-strong);
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1.4rem;
      }

      /* Подвал */
      .site-footer {
        padding: 2rem 0;
        border-top: 1px solid var(--card-border);
        background: var(--bg-accent);
        color: var(--text-muted);
        font-size: 0.9rem;
      }

      .site-footer p {
        margin: 0;
      }

      @media (max-width: 420px) {
        .theme-toggle__label {
          display: none;
        }
        .grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
