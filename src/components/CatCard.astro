---
const { cat } = Astro.props;
const priceFormatted = new Intl.NumberFormat('ru-RU').format(cat.price);
---

<article class="card" data-tilt>
  <div class="card__inner">
    <div class="card__visual" style={`background:${cat.gradient}`}>
      <span class="card__emoji" aria-hidden="true">{cat.emoji}</span>
      <span class="card__badge">{cat.power}</span>
    </div>
    <div class="card__body">
      <h3 class="card__name">{cat.name}</h3>
      <p class="card__desc">{cat.description}</p>
      <div class="card__footer">
        <span class="card__price">{priceFormatted} ₽</span>
        <button class="card__btn" type="button">В корзину</button>
      </div>
    </div>
  </div>
</article>

<style>
  .card {
    perspective: 900px;
    list-style: none;
  }

  .card__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: var(--card-shadow);
    transform-style: preserve-3d;
    transition:
      transform 0.15s ease-out,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
    will-change: transform;
  }

  .card:hover .card__inner {
    box-shadow: var(--card-shadow-hover);
  }

  .card__visual {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    transform: translateZ(40px);
  }

  .card__emoji {
    font-size: clamp(3.5rem, 12vw, 5rem);
    filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.35));
    transition: transform 0.25s ease;
  }

  .card:hover .card__emoji {
    transform: scale(1.12) rotate(-4deg);
  }

  .card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 10px;
    font-size: 0.72rem;
    font-weight: 600;
    color: #fff;
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(4px);
    border-radius: 999px;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.1rem 1.2rem 1.3rem;
    transform: translateZ(25px);
  }

  .card__name {
    margin: 0;
    font-size: 1.2rem;
    color: var(--text-strong);
  }

  .card__desc {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--text-muted);
    flex: 1;
  }

  .card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }

  .card__price {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-strong);
  }

  .card__btn {
    padding: 0.5rem 0.95rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #fff;
    background: var(--accent);
    border: none;
    border-radius: 10px;
    cursor: pointer;
    transition:
      background 0.2s ease,
      transform 0.1s ease;
  }

  .card__btn:hover {
    background: var(--accent-strong);
  }

  .card__btn:active {
    transform: scale(0.96);
  }

  @media (prefers-reduced-motion: reduce) {
    .card__inner,
    .card__emoji {
      transition: none;
    }
  }
</style>
